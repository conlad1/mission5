@{
    ViewData["Title"] = "how to rip lips";
}

<div class="text-start">
    <h1 class="display-4">how to catch hogs</h1>
    
    <div class="container form-control d-flex flex-column align-items-start gap-2">
        <label class="form-label" for="hours">How many hours you want to fish with me?</label>
        <input class="form-text" id="hours" type="number" />
        <button type="button" class="btn btn-dark" id="calculate">calculate cost</button>
    </div>
    
    <label class="form-label">Cost of fishing trip</label>
    <p class="card-text" id="cost">$0.00</p>
    
    <div class="container">
        <img alt="person holding a large bluegill" src="img/fishing3.jpg"/>
        <img alt="person holding a large bass" src="img/fishing4.jpg"/>
    </div>
    
</div>